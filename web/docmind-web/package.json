{
  "name": "docmind-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/serve.mjs",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "test": "ng test --no-watch",
    "test:watch": "ng test",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\" \"e2e/**/*.ts\"",
    "api:types": "node scripts/generate-api-types.mjs",
    "api:types:offline": "node scripts/generate-api-types.mjs --offline",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/material-icons-outlined": "^5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@ngrx/signals": "^22.0.1",
    "dompurify": "^3.5.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "angular-eslint": "^22.8.0",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  }
}
