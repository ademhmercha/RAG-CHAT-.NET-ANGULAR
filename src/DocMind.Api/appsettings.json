{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "docmind",
    "Audience": "docmind-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshTokenAbsoluteDays": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Enabled": true,
    "Global": { "PermitLimit": 300, "WindowSeconds": 60 },
    "Auth": { "PermitLimit": 20, "WindowSeconds": 60 },
    "Chat": { "PermitLimit": 20, "WindowSeconds": 60 },
    "Upload": { "PermitLimit": 20, "WindowSeconds": 60 }
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "ForwardLimit": 1
  },
  "Security": {
    "Hsts": false,
    "RedirectToHttps": false
  },
  "Embedding": {
    "Dimensions": 768
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Documentation": {
    "Enabled": false
  }
}
